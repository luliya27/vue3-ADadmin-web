# Dockerfile for Node.js Backend
FROM node:18-alpine

WORKDIR /app

# Install build dependencies for native modules (sqlite3)
RUN apk add --no-cache python3 python3-dev make g++

# Copy package files only
COPY ../ADadmin-api/package*.json ./

# Install dependencies (will compile native modules in Alpine environment)
RUN npm install

# Copy source code
COPY ../ADadmin-api/ ./

# Remove node_modules if copied and reinstall to ensure correct binaries
RUN rm -rf node_modules && npm install

# Create db directory if not exists
RUN mkdir -p db

# Expose port 3000
EXPOSE 3000

# Start the application
CMD ["npm", "start"]